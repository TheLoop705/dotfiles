#!/usr/bin/python3
"""Click-through CPU/GPU overlay for GNOME's XWayland desktop."""
import concurrent.futures
import json
import os
from pathlib import Path
import signal
import subprocess
import time

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk

CONFIG = Path.home() / ".config/performance-overlay/settings.json"
STATUS = Path(os.environ["XDG_RUNTIME_DIR"]) / "performance-overlay.json"
_intel_fds = []
_intel_discovery_at = 0
TEMPERATURE_THRESHOLDS = {"cpu": 90, "gpu": 85, "ram": 85}


def temperature_sensors():
    sensors = {}
    for hwmon in Path("/sys/class/hwmon").glob("hwmon*"):
        try:
            driver = (hwmon / "name").read_text().strip()
            for label in hwmon.glob("temp*_label"):
                name = label.read_text().strip()
                sensor = label.with_name(label.name.replace("_label", "_input"))
                if driver == "coretemp" and name.startswith("Package id"):
                    sensors["cpu"] = sensor
                elif driver == "dell_ddv" and name == "Memory":
                    sensors["ram"] = sensor
                elif driver == "dell_ddv" and name == "Video":
                    sensors["gpu"] = sensor
        except OSError:
            continue
    return sensors


def read_temperatures(sensors):
    values = {key: None for key in TEMPERATURE_THRESHOLDS}
    for key, sensor in sensors.items():
        try:
            value = int(sensor.read_text()) / 1000
            if 0 < value < 150:
                values[key] = value
        except (OSError, ValueError):
            pass
    return values


def alert_state(data, settings):
    high = any(data[key] is not None and data[key] > float(settings.get("threshold", 90))
               for key in ("cpu", "intel_gpu", "nvidia_gpu"))
    limits = TEMPERATURE_THRESHOLDS | settings.get("temperature_thresholds_c", {})
    hot = [key for key, value in data["temperatures_c"].items()
           if value is not None and value >= float(limits[key])]
    return high, hot, high or bool(hot) or bool(settings.get("always_visible", False))


def cpu_ticks():
    # guest/guest_nice are already included in user/nice.
    ticks = [int(v) for v in Path("/proc/stat").read_text().splitlines()[0].split()[1:9]]
    return sum(ticks), ticks[3] + ticks[4]


def intel_ticks():
    """Aggregate unique DRM clients; duplicated file descriptors count once."""
    global _intel_fds, _intel_discovery_at
    discover = time.monotonic() >= _intel_discovery_at
    paths = []
    if discover:
        for proc in Path("/proc").iterdir():
            try:
                if proc.name.isdigit() and proc.stat().st_uid == os.getuid():
                    paths.extend((proc / "fdinfo").iterdir())
            except OSError:
                continue
    else:
        paths = _intel_fds
    clients = {}
    found = []
    for fd in paths:
        try:
            fields = dict(line.split(":", 1) for line in fd.read_text().splitlines() if ":" in line)
            if fields.get("drm-driver", "").strip() != "i915":
                continue
            found.append(fd)
            client = (fields["drm-pdev"].strip(), fields["drm-client-id"].strip())
            engines = {}
            for key, value in fields.items():
                if key.startswith("drm-engine-") and not key.startswith("drm-engine-capacity-"):
                    engine = key.removeprefix("drm-engine-")
                    capacity = int(fields.get(f"drm-engine-capacity-{engine}", "1"))
                    engines[engine] = (int(value.split()[0]), max(1, capacity))
            clients[client] = engines
        except (OSError, KeyError, ValueError):
            continue
    if discover:
        _intel_discovery_at = time.monotonic() + 10
    _intel_fds = found
    return clients


def intel_usage(previous, current, elapsed):
    engines = {}
    for client, values in current.items():
        if client not in previous:
            continue
        for engine, (ticks, capacity) in values.items():
            if engine not in previous[client]:
                continue
            delta = max(0, ticks - previous[client][engine][0])
            engines[engine] = engines.get(engine, 0) + delta / capacity
    # Parallel render/video engines are independent; report the busiest.
    return min(100.0, max(engines.values(), default=0) / elapsed / 1e9 * 100)


def nvidia_readings():
    devices = []
    for vendor in Path("/sys/class/drm").glob("card[0-9]*/device/vendor"):
        if vendor.read_text().strip() == "0x10de":
            devices.append(vendor.parent)
    if not devices:
        return None, None
    # Don't wake a sleeping discrete GPU just to monitor it.
    if all((d / "power/runtime_status").read_text().strip() == "suspended" for d in devices):
        return 0.0, None
    try:
        result = subprocess.run(
            ["/usr/bin/nvidia-smi", "--query-gpu=utilization.gpu,temperature.gpu", "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=2, check=True,
        )
        rows = [[float(value.strip()) for value in line.split(",")] for line in result.stdout.splitlines()]
        return max(row[0] for row in rows), max(row[1] for row in rows)
    except (OSError, ValueError, subprocess.SubprocessError):
        return None, None


class Sampler:
    def __init__(self):
        self.cpu = cpu_ticks()
        self.intel = intel_ticks()
        self.timestamp = time.monotonic()
        self.sensors = temperature_sensors()

    def sample(self):
        cpu = cpu_ticks()
        intel = intel_ticks()
        now = time.monotonic()
        total = cpu[0] - self.cpu[0]
        busy = total - (cpu[1] - self.cpu[1])
        nvidia, gpu_temperature = nvidia_readings()
        temperatures = read_temperatures(self.sensors)
        if gpu_temperature is not None:
            temperatures["gpu"] = gpu_temperature
        result = {
            "cpu": round(max(0, min(100, busy / total * 100)), 1) if total else 0,
            "intel_gpu": round(intel_usage(self.intel, intel, now - self.timestamp), 1),
            "nvidia_gpu": nvidia,
            "temperatures_c": temperatures,
            "updated_at": time.time(),
        }
        self.cpu, self.intel, self.timestamp = cpu, intel, now
        return result


class Overlay:
    def __init__(self):
        self.sampler = Sampler()
        self.executor = concurrent.futures.ThreadPoolExecutor(max_workers=1)
        self.pending = None
        self.window = Gtk.Window(title="CPU GPU Performance Overlay")
        self.window.set_wmclass("performance-overlay", "PerformanceOverlay")
        self.window.set_decorated(False)
        self.window.set_resizable(False)
        self.window.set_keep_above(True)
        self.window.set_skip_taskbar_hint(True)
        self.window.set_skip_pager_hint(True)
        self.window.set_accept_focus(False)
        self.window.set_focus_on_map(False)
        self.window.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION)
        self.window.stick()
        self.label = Gtk.Label()
        self.label.set_margin_start(12)
        self.label.set_margin_end(12)
        self.label.set_margin_top(7)
        self.label.set_margin_bottom(7)
        self.window.add(self.label)
        provider = Gtk.CssProvider()
        provider.load_from_data(b"window { background: rgba(15, 20, 24, 0.92); border-radius: 8px; } label { font: bold 14px monospace; }")
        Gtk.StyleContext.add_provider_for_screen(self.window.get_screen(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.window.connect("realize", lambda w: w.get_window().set_pass_through(True))
        self.window.connect("size-allocate", self.position)
        self.window.get_screen().connect("monitors-changed", self.position)
        GLib.timeout_add(2000, self.tick)
        self.tick()

    def position(self, *_args):
        display = self.window.get_display()
        monitor = display.get_primary_monitor() or display.get_monitor(0)
        if monitor:
            area = monitor.get_workarea()
            width, _height = self.window.get_size()
            self.window.move(area.x + area.width - width - 12, area.y + 12)

    def tick(self):
        if self.pending is None or self.pending.done():
            self.pending = self.executor.submit(self.sampler.sample)
            self.pending.add_done_callback(lambda future: GLib.idle_add(self.update, future))
        return GLib.SOURCE_CONTINUE

    def update(self, future):
        try:
            data = future.result()
            settings = {"threshold": 90, "always_visible": False}
            if CONFIG.exists():
                settings.update(json.loads(CONFIG.read_text()))
            high, hot, visible = alert_state(data, settings)
            data["high_usage"] = high
            data["critical_temperatures"] = hot
            data["visible"] = visible
            temporary = STATUS.with_suffix(".tmp")
            temporary.write_text(json.dumps(data) + "\n")
            temporary.replace(STATUS)
            text = f'CPU {data["cpu"]:5.1f}%  Intel GPU {data["intel_gpu"]:5.1f}%'
            text += f'  NVIDIA GPU {data["nvidia_gpu"]:5.1f}%' if data["nvidia_gpu"] is not None else "  NVIDIA GPU N/A"
            color = "#55ff88" if high else "#eeeeee"
            markup = f'<span foreground="{color}">{text}</span>'
            if hot:
                temperatures = "  ".join(f'{key.upper()} {data["temperatures_c"][key]:.0f}°C' for key in hot)
                markup += f'\n<span foreground="#ff6666">HIGH TEMP: {temperatures}</span>'
            self.label.set_markup(markup)
            if data["visible"]:
                self.window.show_all()
                self.position()
            else:
                self.window.hide()
        except Exception as error:
            # Exit on collector/UI failure so systemd can recover. Never leave
            # old values visible as if they were still current.
            print(f"Performance overlay failed: {error}", flush=True)
            self.window.hide()
            Gtk.main_quit()
        return GLib.SOURCE_REMOVE


if __name__ == "__main__":
    signal.signal(signal.SIGTERM, lambda *_: GLib.idle_add(Gtk.main_quit))
    overlay = Overlay()
    try:
        Gtk.main()
    finally:
        overlay.executor.shutdown(wait=True, cancel_futures=True)
        STATUS.unlink(missing_ok=True)
