[Unit]
Description=CPU and GPU performance overlay
After=graphical-session.target
PartOf=graphical-session.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/performance-overlay
Environment=GDK_BACKEND=x11
Restart=always
RestartSec=5
TimeoutStopSec=5
UMask=0077

[Install]
WantedBy=graphical-session.target
